# Never commit real credentials or a filled-in .env file.
# Nested Pydantic settings use double underscores.
# MEMEGEN_LLM__API_KEY=replace-me
# MEMEGEN_LLM__MODEL=openai/gpt-4o-mini
# MEMEGEN_LLM__API_BASE=https://api.openai.com/v1
# MEMEGEN_DATABASE__URL=sqlite+pysqlite:///./memes.sqlite3
# MEMEGEN_DATABASE__URL=postgresql+psycopg://user:pass@localhost/memegen
