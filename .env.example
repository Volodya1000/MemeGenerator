# Copy to .env; never commit the filled-in file.
# For hosted OpenAI-compatible providers:
MEMEGEN_API_KEY=replace-me
# Optional environment overrides:
# MEMEGEN_MODEL=openai/gpt-4o-mini
# MEMEGEN_BASE_URL=https://api.openai.com/v1

# Set this for catalog_backend: sqlalchemy; keep credentials out of YAML.
# MEMEGEN_DATABASE_URL=sqlite+pysqlite:///./memes.sqlite3
# MEMEGEN_DATABASE_URL=postgresql+psycopg://user:password@localhost/memegen
